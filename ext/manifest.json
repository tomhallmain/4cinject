{
  "name": "4CIJ",
  "version": "2.0.1",
  "manifest_version": 3,
  "description": "Keyboard navigation, thread filtering and seen-content tracking for 4chan boards.",
  "homepage_url": "https://4chan.org",
  "background": {
    "service_worker": "background/worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://boards.4chan.org/*",
        "https://boards.4channel.org/*"
      ],
      "js": [ "page/bridge.js" ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://boards.4chan.org/*",
        "https://boards.4channel.org/*"
      ],
      "js": [
        "shared/actions.js",
        "shared/util.js",
        "content/settings.js",
        "content/dom.js",
        "content/marks.js",
        "content/model.js",
        "content/messaging.js",
        "content/text-transforms.js",
        "content/media.js",
        "content/navigation.js",
        "content/reports.js",
        "content/thread-page.js",
        "content/catalog-page.js",
        "content/commands.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": "icon.png",
    "default_title": "4CIJ",
    "default_popup": "popup/index.html"
  },
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://*.4chan.org/*",
    "https://*.4channel.org/*",
    "https://*.4cdn.org/*"
  ]
}
